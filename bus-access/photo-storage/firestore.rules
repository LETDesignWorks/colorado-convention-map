rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing deployed behavior retained for public map and ordinary reviews.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "michaeltarin@hotmail.com";
    }
    function isPhotoAdmin() {
      return request.auth != null
        && request.auth.uid == 'jPTl6zfkjaTbbCJMI7A7xXE2BN93';
    }
    match /halls/{hallId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /reviews/{reviewId} {
      // The verified owner can already read every review by ID. Authorize
      // collection queries without requiring a document-ID prefix proof.
      // Both identity checks keep photo metadata restricted to that same owner.
      allow list: if isAdmin() && isPhotoAdmin();

      // The original broad review grant must exclude the photo prefix: a
      // narrower match cannot override an existing permissive match.
      allow read, create, update, delete: if
        (!reviewId.matches('photo-library-.*') && isAdmin())
        || (reviewId.matches('photo-library-.*') && isPhotoAdmin());
    }
  }
}

