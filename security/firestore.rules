rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'jPTl6zfkjaTbbCJMI7A7xXE2BN93';
    }
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.email is string;
    }
    function policyKey() { return 'site-access-' + request.auth.token.email.lower(); }
    function level(section) {
      let policy = get(/databases/$(database)/documents/reviews/$(policyKey())).data;
      return policy.get('schemaVersion', 0) == 1 && policy.get('enabled', false) == true
        && policy.get('email', '') == request.auth.token.email.lower()
        ? policy.get('permissions', {}).get(section, 'none') : 'none';
    }
    function canView(section) {
      return section != '' && verified() && level(section) in ['view', 'edit'];
    }
    function canEdit(section) {
      return section != '' && verified() && level(section) == 'edit';
    }
    function reserved(id) { return id.matches('site-access-.*') || id.matches('photo-library-.*'); }
    function reviewSection(data) {
      let kind = data.get('recordType', '');
      return kind in ['territory-boundary', 'territory-plan', 'territory-plan-chunk', 'territory-pdf', 'territory-pdf-part', 'territory-name-choice'] ? 'territories'
        : kind in ['bus-route', 'route-plan', 'rtd-station'] ? 'routes'
        : kind == 'activity-bus-plan' ? 'activities'
        : kind in ['activity-multistop-route', 'delegate-count'] ? 'activityPlanning'
        : kind == 'congregation-hosting-plan' ? 'assignments'
        : kind == '' ? 'busAccess' : '';
    }
    function hallSection(data) {
      let kind = data.get('recordType', '');
      return kind in ['congregation-assignment', 'congregation-address', 'congregation-service-days'] ? 'assignments'
        : kind == 'smpw-location' ? 'smpw'
        : kind == 'south-dtc-rail-connection' ? 'rail'
        : kind == '' ? 'busAccess' : '';
    }
    function sameType() {
      return resource.data.get('recordType', '') == request.resource.data.get('recordType', '');
    }
    function validReviewRecord(id, data, creating) {
      return data.get('recordType', '') == 'congregation-hosting-plan'
        ? !id.matches('delegate-count-.*') && data.keys().hasOnly(['recordType','schemaVersion','planName','planJson','revision','updatedAt','updatedByEmail'])
          && data.schemaVersion == 1 && data.planName is string && data.planName.size() > 0 && data.planName.size() <= 140
          && data.planJson is string && data.planJson.size() <= 850000
          && data.revision is int && data.revision == (creating ? 1 : resource.data.get('revision', 0) + 1)
          && data.updatedByEmail == request.auth.token.email && data.updatedAt is timestamp
        : data.get('recordType', '') != 'delegate-count' ? !id.matches('delegate-count-.*')
        : data.keys().hasOnly(['recordType','schemaVersion','date','category','locationId','locationName','locationAddress','count','notes','revision','updatedAt','updatedByEmail'])
          && data.schemaVersion == 1 && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && data.category in ['activity','meeting','hotel']
          && data.locationId is string && data.locationId.matches('[-A-Za-z0-9_]{1,120}')
          && id == 'delegate-count-' + data.date + '-' + data.category + '-' + data.locationId
          && data.locationName is string && data.locationName.size() > 0 && data.locationName.size() <= 140
          && data.locationAddress is string && data.locationAddress.size() <= 300
          && data.count is int && data.count >= 0 && data.count <= 100000
          && data.notes is string && data.notes.size() <= 1000
          && data.revision is int && data.revision == (creating ? 1 : resource.data.get('revision', 0) + 1)
          && data.updatedByEmail == request.auth.token.email && data.updatedAt is timestamp;
    }
    function validHallRecord(id, data) {
      let kind = data.get('recordType', '');
      return kind == 'congregation-service-days'
        ? data.get('congregationId', '') is string && id == 'congregation-service-days-' + data.congregationId.lower()
          && data.keys().hasOnly(['recordType','congregationId','congregationName','serviceDays','updatedBy','updatedAt'])
          && data.serviceDays is list && data.serviceDays.size() <= 7 && data.serviceDays.hasOnly(['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'])
        : kind == 'congregation-assignment'
        ? data.get('congregationId', '') is string && id == 'congregation-' + data.congregationId.lower()
          && data.keys().hasOnly(['recordType','congregationId','congregationName','sourceName','homeAddress','meetingPointId','meetingPointLabel','meetingPointName','meetingPointAddress','meetingPointType','assigned','updatedByEmail','updatedAt'])
        : kind == 'congregation-address'
        ? data.get('congregationId', '') is string && id == 'congregation-address-' + data.congregationId.lower()
          && data.keys().hasOnly(['recordType','congregationId','congregationName','homeAddress','lat','lng','addressNeedsReview','pinSource','addressVersion','updatedByEmail','updatedAt'])
        : kind == 'south-dtc-rail-connection'
        ? id.matches('rail-.*') && data.keys().hasOnly(['recordType','hotelId','hotelName','meetingPointId','meetingPointLabel','meetingPointName','originStationId','originStationName','destinationStationId','destinationStationName','firstMileMode','lastMileMode','publicNote','updatedByEmail','updatedAt'])
        : kind == 'smpw-location'
        ? id.matches('[A-Za-z0-9]{20}') && data.keys().hasOnly(['recordType','markerLabel','name','address','lat','lng','status','cartCount','schedule','contact','notes','updatedByEmail','updatedAt','createdByEmail','createdAt'])
        : kind == '' && !id.matches('congregation-.*') && !id.matches('rail-.*');
    }
    // Successful server read proves these rules are installed. No data is stored here.
    match /siteAccessCapabilities/v1 { allow get: if true; }
    match /siteAccessCapabilities/serviceDaysV1 { allow get: if true; }
    match /siteAccessCapabilities/delegateCountsV1 { allow get: if true; }
    match /siteAccessCapabilities/hostingPlansV1 { allow get: if true; }
    match /halls/{hallId} {
      allow read: if true;
      allow create: if isOwner() || (validHallRecord(hallId, request.resource.data) && canEdit(hallSection(request.resource.data)));
      allow update: if isOwner() || (sameType() && validHallRecord(hallId, request.resource.data) && canEdit(hallSection(resource.data)));
      allow delete: if isOwner() || canEdit(hallSection(resource.data));
    }
    match /reviews/{reviewId} {
      allow get: if isOwner()
        || (verified() && reviewId == policyKey())
        || (!reserved(reviewId) && ((resource == null && (canView('busAccess') || (reviewId.matches('delegate-count-.*') && canView('activityPlanning'))))
          || (resource != null && canView(reviewSection(resource.data)))));
      // Clients must query only record types that their account can read.
      allow list: if isOwner() || canView(reviewSection(resource.data));
      allow create: if isOwner() || (!reserved(reviewId) && validReviewRecord(reviewId, request.resource.data, true) && canEdit(reviewSection(request.resource.data)));
      allow update: if isOwner() || (!reserved(reviewId) && sameType() && validReviewRecord(reviewId, request.resource.data, false) && canEdit(reviewSection(resource.data)));
      allow delete: if isOwner() || (!reserved(reviewId) && canEdit(reviewSection(resource.data)));
    }
  }
}
